@page "{Id:guid}"
@model KamiYomu.Web.Areas.Settings.Pages.CrawlerAgents.Edit.IndexModel
@{
    ViewData["Title"] = I18n.EditCrawlerAgent;
}

<div class="d-flex justify-content-between align-items-center m-3">
    <h2 class="h5 mb-0 text-primary">
        <i class="bi bi-puzzle me-3"></i>
        @I18n.EditCrawlerAgent
    </h2>
</div>

<form method="post"
      asp-area="Settings"
      asp-page="/CrawlerAgents/Edit/Index"
      asp-page-handler="Save"
      class="needs-validation"
      novalidate>

    <partial name="_EditForm" model="Model.Input" />

    <!-- Hidden fields to preserve state -->
    <input type="hidden" asp-for="RequiresConfirmation" />
    <input type="hidden" asp-for="ShowConfirmationDialog" />
    <input type="hidden" asp-for="LibrariesUsingThisCrawlerAgent" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (Model.ShowConfirmationDialog)
    {
        <partial name="_CrawlerAgentConfirmationDialog" model="Model" />
    }
</form>



