@page
@using System.Text
@using KamiYomu.Web.Areas.Libraries.Pages.Collection.Dialogs
@using KamiYomu.Web.Entities.CrawlerAgentRuntime.Interfaces
@using KamiYomu.Web.Extensions
@using KamiYomu.Web.Infrastructure.Services.Interfaces
@inject IUserClockManager UserClockService
@inject ICrawlerAgentFactory crawlerAgentFactory
@model KamiYomu.Web.Areas.Libraries.Pages.Collection.Dialogs.DownloadStatusModel
@{
    Layout = null;
    using ICrawlerAgentDecorator crawlerInstance = crawlerAgentFactory.Create(Model.Library.CrawlerAgent);
    var faviconUrl = await crawlerInstance.GetFaviconAsync(CancellationToken.None);
    var badgeClass = Model.Record.DownloadStatus switch
    {
        Entities.Definitions.DownloadStatus.ToBeRescheduled => "bg-warning",
        Entities.Definitions.DownloadStatus.Scheduled => "bg-primary",
        Entities.Definitions.DownloadStatus.InProgress => "bg-info",
        Entities.Definitions.DownloadStatus.Completed => "bg-success",
        Entities.Definitions.DownloadStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
    var lastUpdateBuilder = new StringBuilder();
    lastUpdateBuilder.AppendLine($"{I18n.LastUpdate}: {UserClockService.ConvertToUserTime(Model.Record.StatusUpdateAt.GetValueOrDefault())}.");
    if (!string.IsNullOrWhiteSpace(Model.Record.StatusReason))
    {
        lastUpdateBuilder.AppendLine(Model.Record.StatusReason);
    }

}
<div class="modal-header">
    <h5 class="modal-title">@I18n.DownloadStatus</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body" id="DownloadStatusContainer">
    <div class="container-fluid">
        <div class="row g-4">
            <div class="col-md-4">
                <vc:manga-info-vertical manga="@Model.Library.Manga" />
            </div>

            <div class="col-md-8">
                <h2 class="fw-bold mb-3">@Model.Library.Manga.Title</h2>

                <div class="mb-3 d-flex align-items-center">
                    <span class="fw-semibold me-2">@I18n.CrawlerAgent:</span>
                    <img src="@faviconUrl.ToInternalImageUrl()" width="20" class="me-2" alt="favicon" />
                    <span class="text-muted">@Model.Library.CrawlerAgent.DisplayName</span>
                </div>

                <div class="d-flex align-items-center gap-3 mb-3">
                    <vc:follow-button view-model="@Model.FollowButtonViewModel" />
                    <vc:scan-now-button view-model="@Model.ScanNowButtonViewModel" />
                </div>
                <div class="mb-1 row align-items-center">
                    <vc:download-progress library="@Model.Library"/>
                </div>

                <div class="mb-1 row">
                    <label class="col-sm-3 col-form-label fw-semibold">
                        @I18n.FilePathFormat
                    </label>
                    <div class="col-sm-9">
                        <div class="form-control-plaintext">
                            <code class="text-muted text-break">
                                @Model.Library.GetFilePathTemplate()
                            </code>
                        </div>
                    </div>
                </div>

                <div class="mb-1 row">
                    <label class="col-sm-3 col-form-label fw-semibold">
                        @I18n.TitleFormat
                    </label>
                    <div class="col-sm-9">
                        <div class="form-control-plaintext">
                            <code class="text-muted text-break">
                                @Model.Library.GetComicInfoTitleTemplate()
                            </code>
                        </div>
                    </div>
                </div>
                <div class="mb-1 row">
                    <label class="col-sm-3 col-form-label fw-semibold">
                        @I18n.SeriesNameFormat
                    </label>
                    <div class="col-sm-9">
                        <div class="form-control-plaintext">
                            <code class="text-muted text-break">
                                @Model.Library.GetComicInfoSeriesTemplate()
                            </code>
                        </div>
                    </div>
                </div>

                <div class="mb-1 row">
                    <label class="col-sm-3 col-form-label fw-semibold">
                        @I18n.CurrentDirectory
                    </label>
                    <div class="col-sm-9">
                        <div class="form-control-plaintext">
                            <code class="text-muted text-break">
                                @Model.Library.GetMangaDirectory()
                            </code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion g-4 mt-2" id="downloadAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTable">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapseTable"
                            hx-get="@Url.Page("DownloadChapterTable")?libraryId=@Model.Library.Id"
                            hx-trigger="click"
                            hx-target="#collapseTable"
                            hx-swap="innerHTML">
                        @I18n.ChaptersFound
                    </button>
                </h2>
                <div id="collapseTable"
                     class="accordion-collapse collapse">
                    <div class="accordion-body">
                        <div class="text-muted">Loading table…</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {
      const popoverTriggerList = [].slice.call(
        document.querySelectorAll('#DownloadStatusContainer [data-bs-toggle="popover"]')
      );
      popoverTriggerList.forEach(function (el) {
        new bootstrap.Popover(el, {
          container: '#DownloadStatusContainer'
        });
      });
    });
</script>
